<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!--
      OJO: esto tiene que ser una base MySQL de PRUEBA, separada de la real
      (mismo esquema/tablas, pero vacía o descartable). Los tests de
      integración (los que dicen "Integration" en el nombre del archivo)
      insertan y borran filas acá — nunca apunten esto a la base del cliente.

      Los tests "puros" (CuotaServiceCalculosTests, PagoServiceCalculosTests,
      NivelUtilsTests) no necesitan que esta base exista de verdad para
      correr — pero SÍ necesitan que este connection string esté presente,
      porque el constructor de PagoService/CuotaService lo exige al crearse,
      aunque el método que se testea no llegue a usarlo.
    -->
    <add name="GestionEducativa"
         connectionString="Server=localhost;Database=gestioneducativa_test;Uid=root;Pwd=CAMBIAR_ESTO;"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
</configuration>
